# ─── SUPABASE ────────────────────────────────────────────────
# Acesse: https://supabase.com → seu projeto → Settings → API
# Estas variáveis VITE_ ficam no bundle do browser (a anon key é pública por design)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ─── GOOGLE GEMINI — SERVER-SIDE (Vercel) ────────────────────
# Configure em: Vercel → Settings → Environment Variables
# SEM o prefixo VITE_ para NÃO vazar no bundle do browser
# Usado para: análise da foto de inspiração (/api/analyze-image)
GEMINI_API_KEY=AIza...

# ─── SERVIDOR (server-side) — também usado pelo `vercel dev` local ──
# Para o servidor validar o login nas rotas /api (mesmos valores do bloco Supabase):
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Opcionais:
# GEMINI_MODEL=gemini-2.5-flash
# ALLOWED_EMAILS=pessoa1@gmail.com,pessoa2@gmail.com   # se preenchido, só esses usam a IA

# ⚠️ NUNCA use o prefixo VITE_ em chaves secretas: o build agora FALHA de propósito
# se encontrar VITE_*KEY / *SECRET / *TOKEN (exceto VITE_SUPABASE_ANON_KEY).
